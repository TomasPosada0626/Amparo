# Copia este archivo a .env (gitignored) y completa los valores que uses.

# tools/model_comparator -- Ollama local, no necesita API key.
# Deja el default salvo que corras Ollama en otro host/puerto.
OLLAMA_BASE_URL=http://localhost:11434/v1

# tools/evaluation/external_judge.py -- juez externo (Groq, capa gratuita)
# usado en M2 para contrastar el juez local (misma familia que el modelo
# evaluado) con uno independiente. Genera una key gratis en
# https://console.groq.com/keys -- OJO: que modelos estan disponibles
# depende de tu cuenta; revisa console.groq.com/playground si el default
# de abajo te da "model_not_found". La capa gratuita tiene un limite de
# ~200,000 tokens/dia por cuenta.
GROQ_API_KEY=
# Opcional: modelo de Groq a usar como juez (default: openai/gpt-oss-120b)
GROQ_JUDGE_MODEL=openai/gpt-oss-120b
